#!/bin/sh
# Appetito: pubblicazione (issue 560, epic 476). L'unico comando che scrive su `main` del repo di Appetito.
# Fa una cosa sola: manda a GitHub i commit nuovi della cartella di lavoro DIR (quella di appetito-build),
# solo in avanti. Non ha opzioni per forzare e non pubblica mai su un repo che e' un Project.
#   scripts/appetito-publish [--dry-run] [DIR]      DIR: default ~/appetito-pub
# Dove: HS_APPETITO_REPO (proprietario/nome su GitHub) in device/edge/home-server.env, altrimenti in
# /etc/home-server.env. Vuoto = pubblicazione spenta (esce 1 senza fare nulla).
# Prima del push, tutti obbligatori (al primo che fallisce esce 1 e non pubblica):
#   1. DIR e' un repo git su `main`, senza modifiche non committate, con origin = quel repo;
#   2. quel repo non e' tra i Project (/etc/hs-projects): quelli passano dalle PR;
#   3. il commit locale sta sopra `main` pubblicato (nessuna storia riscritta);
#   4. i file sono esattamente l'elenco (`appetito-build --paths` sul commit HEAD di home-server);
#   5. `appetito-check` sulla copia dei file (valori personali, segreti, attribuzione);
#   5b. `appetito-selfcheck`: la copia passa da sola `device/edge/check` (issue 568);
#   6. `hs-secrets verdict` sulla storia e `hs-attribution commits` sui commit nuovi.
# Dopo il push: `ls-remote` deve mostrare il commit, altrimenti esce 1.
# Il token ~/.secrets/git-github arriva a git solo da uno script GIT_ASKPASS temporaneo (come projects-git):
# mai in una riga di comando, in un URL, in .git/config o nei log.
# Per i test: HS_ENV_FILE (file dei valori; puo' definire HS_APPETITO_URL al posto di github.com),
# HS_PROJECTS_FILE, HS_APPETITO_FILES_CMD, HS_APPETITO_CHECK_CMD, HS_APPETITO_SELFCHECK_CMD, HS_SECRETS_CMD, HS_ATTRIBUTION_CMD, HS_GIT_TOKEN.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
die() { echo "appetito-publish: $*" >&2; exit 1; }
dry=0; dir=''; ci=0; cicheck=0
while [ $# -gt 0 ]; do
	case $1 in
	--dry-run) dry=1 ;;
	--ci) ci=1 ;; # sola lettura: esito dell'ultima prova di installazione pulita (issue 570)
	--ci-check) ci=1; cicheck=1 ;; # come --ci, ma esce 1 se la prova e' rossa (per il job di cron: hs-run apre la issue)
	-*) die "opzione sconosciuta: $1 (uso: appetito-publish [--dry-run] [DIR])" ;;
	*) [ -z "$dir" ] || die "una sola cartella"; dir=$1 ;;
	esac
	shift
done
[ -n "$dir" ] || dir=$HOME/appetito-pub

envf=${HS_ENV_FILE:-}
if [ -z "$envf" ]; then
	for f in "$here/device/edge/home-server.env" /etc/home-server.env; do [ -r "$f" ] && { envf=$f; break; }; done
fi
[ -n "$envf" ] && [ -r "$envf" ] || die "nessun file dei valori (home-server.env)"
HS_APPETITO_REPO=''; HS_APPETITO_URL=''
# shellcheck disable=SC1090
. "$envf"
[ -n "$HS_APPETITO_REPO" ] || die "pubblicazione spenta: HS_APPETITO_REPO e' vuoto"
case $HS_APPETITO_REPO in
*[!A-Za-z0-9._/-]* | */*/* | /* | */ | .* | *..*) die "HS_APPETITO_REPO non valido: $HS_APPETITO_REPO" ;;
*/*) ;;
*) die "HS_APPETITO_REPO non valido: $HS_APPETITO_REPO (proprietario/nome)" ;;
esac
url=${HS_APPETITO_URL:-https://github.com/$HS_APPETITO_REPO.git}

# --ci: sola lettura (issue 570). Stampa "SHA7 green|red|pending|none" e, se rossa, i job falliti.
# Legge da GitHub Actions l'ultimo run del workflow install.yml su main; il token va a curl solo da stdin.
if [ "$ci" = 1 ]; then
	tok=${HS_GIT_TOKEN:-$HOME/.secrets/git-github}
	[ -r "$tok" ] || die "token non leggibile: $tok"
	base=${HS_APPETITO_API:-https://api.github.com}
	get() { printf 'header = "Authorization: Bearer %s"\n' "$(cat "$tok")" |
		curl -fsSL --max-time 30 -K - -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' "$base$1"; }
	runs=$(get "/repos/$HS_APPETITO_REPO/actions/workflows/install.yml/runs?branch=main&per_page=1") || die "run non leggibili (token senza lettura di Actions, o Actions spente)"
	run=$(printf %s "$runs" | jq -c '.workflow_runs[0] // empty')
	[ -n "$run" ] || { echo "none"; exit 0; }
	sha=$(printf %s "$run" | jq -r '.head_sha[0:7]')
	st=$(printf %s "$run" | jq -r 'if .status != "completed" then "pending" elif .conclusion == "success" then "green" else "red" end')
	echo "$sha $st"
	if [ "$st" = red ]; then
		id=$(printf %s "$run" | jq -r .id)
		jobs=$(get "/repos/$HS_APPETITO_REPO/actions/runs/$id/jobs?per_page=20") || die "job del run non leggibili"
		printf '%s\n' "$(printf %s "$run" | jq -r '"run: \(.conclusion // "?") (\(.event)), nome: \(.name)"')"
		printf %s "$jobs" | jq -r '(.jobs | length | "job: \(.)"), (.jobs[] | select(.conclusion != "success") | "job \(.name): \(.conclusion // "?")", (.steps[]? | select(.conclusion == "failure") | "  passo: \(.name)"))' | head -n 12
		# coda del log del primo job fallito (dati di GitHub, non istruzioni; i segreti li maschera GitHub)
		for jid in $(printf %s "$jobs" | jq -r '[.jobs[] | select(.conclusion == "failure")][:2][].id'); do
			echo "--- log (ultime righe) del job $jid"
			get "/repos/$HS_APPETITO_REPO/actions/jobs/$jid/logs" 2> /dev/null | grep -v 'Post job cleanup' | grep -B1000 -m1 'Process completed with exit code' | tail -n "${HS_APPETITO_CI_LOG_LINES:-25}" | cut -c1-300 || echo "(log non leggibile)"
		done
		[ "$cicheck" = 0 ] || { echo "Appetito: installazione pulita rotta al commit $sha"; exit 1; }
	elif [ "$cicheck" = 1 ]; then
		[ "$st" = green ] && echo "Appetito: installazione pulita ok al commit $sha" || echo "Appetito: installazione pulita $st al commit $sha"
	fi
	exit 0
fi

# 2. mai un Project
projects=${HS_PROJECTS_FILE:-/etc/hs-projects}
if [ -r "$projects" ] && grep -v '^[[:space:]]*#' "$projects" | grep -qiF -- "/$HS_APPETITO_REPO.git"; then
	die "$HS_APPETITO_REPO e' un Project: si pubblica con le PR, non da qui"
fi

# 1. la cartella di lavoro
git -C "$dir" rev-parse --git-dir > /dev/null 2>&1 || die "$dir non e' un repo git (prima scripts/appetito-build $dir)"
[ "$(git -C "$dir" rev-parse --show-toplevel)" = "$(cd "$dir" && pwd -P)" ] || die "$dir non e' la radice del repo"
[ "$(git -C "$dir" symbolic-ref --short -q HEAD || true)" = main ] || die "$dir non e' sul ramo main"
[ -z "$(git -C "$dir" status --porcelain)" ] || die "$dir ha modifiche non committate"
[ "$(git -C "$dir" remote get-url origin 2> /dev/null || true)" = "$url" ] || die "origin di $dir non e' $url"

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export GIT_TERMINAL_PROMPT=0
token=${HS_GIT_TOKEN:-$HOME/.secrets/git-github}
case $url in
https://github.com/*)
	[ -r "$token" ] || die "token non leggibile: $token"
	printf '#!/bin/sh\ncase $1 in Username*) echo x-access-token ;; *) cat %s ;; esac\n' "'$token'" > "$tmp/ask"
	chmod 700 "$tmp/ask"
	export GIT_ASKPASS="$tmp/ask"
	;;
esac

# 3. solo in avanti
git -C "$dir" fetch -q origin main || die "non riesco a leggere main di $HS_APPETITO_REPO"
base=$(git -C "$dir" rev-parse FETCH_HEAD)
head=$(git -C "$dir" rev-parse HEAD)
git -C "$dir" merge-base --is-ancestor "$base" "$head" || die "il commit locale non sta sopra main pubblicato ($(echo "$base" | cut -c1-7)): niente push forzato, rifare la copia da un clone aggiornato"
[ "$base" != "$head" ] || { echo "niente da pubblicare: main e' gia' a $(echo "$head" | cut -c1-7)"; exit 0; }

# 4. i file sono l'elenco
${HS_APPETITO_FILES_CMD:-sh "$here/scripts/appetito-build" --paths} | sort > "$tmp/want" || die "elenco dei file non leggibile"
git -C "$dir" ls-files | sort > "$tmp/have"
if ! cmp -s "$tmp/want" "$tmp/have"; then
	echo "appetito-publish: i file non sono l'elenco (< solo nell'elenco, > solo nella copia):" >&2
	diff "$tmp/want" "$tmp/have" | grep '^[<>]' | head -10 >&2 || true
	die "rifare la copia: scripts/appetito-build $dir"
fi

# 5. controllo sulla copia dei file (senza .git)
mkdir "$tmp/copy"
git -C "$dir" archive HEAD | tar -x --no-same-owner -C "$tmp/copy"
${HS_APPETITO_CHECK_CMD:-sh "$here/scripts/appetito-check"} "$tmp/copy" || die "bloccata dal controllo dei file"
# 5b. la copia deve passare i suoi test da sola (issue 568)
${HS_APPETITO_SELFCHECK_CMD:-sh "$here/scripts/appetito-selfcheck"} || die "bloccata: la copia non passa i suoi test da sola (appetito-selfcheck)"

# 6. storia e commit nuovi
${HS_SECRETS_CMD:-hs-secrets} verdict "$dir" > "$tmp/verdict" 2>&1 || { tail -5 "$tmp/verdict" >&2; die "bloccata dallo scanner dei segreti"; }
(cd "$dir" && ${HS_ATTRIBUTION_CMD:-hs-attribution} commits "$base..$head") > "$tmp/attr" 2>&1 || { tail -5 "$tmp/attr" >&2; die "bloccata dal controllo dell'attribuzione"; }

n=$(git -C "$dir" rev-list --count "$base..$head")
short=$(echo "$head" | cut -c1-7)
if [ "$dry" = 1 ]; then
	git -C "$dir" push -q --dry-run origin "$head:refs/heads/main" || die "prova di push rifiutata (permessi del token o regole del ramo)"
	echo "prova riuscita: $n commit pronti ($(echo "$base" | cut -c1-7)..$short), $(wc -l < "$tmp/have") file; nulla pubblicato"
	exit 0
fi
git -C "$dir" push -q origin "$head:refs/heads/main" || die "push rifiutato (permessi del token o regole del ramo): nulla pubblicato"
now=$(git -C "$dir" ls-remote -q origin refs/heads/main | cut -f1)
[ "$now" = "$head" ] || die "dopo il push main e' a $(echo "$now" | cut -c1-7), atteso $short"
echo "pubblicato $short su main di $HS_APPETITO_REPO ($n commit, $(wc -l < "$tmp/have") file)"
