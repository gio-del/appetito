#!/bin/sh
# Appetito: controllo prima della pubblicazione (issue 486, epic 476).
# Guarda la copia filtrata DIR (senza .git) e si ferma al primo problema (exit 1, dice file e riga):
#   1. valori personali e segreti: `hs-secrets dir DIR` (issue 529, un solo elenco: valori di home-server.env e del
#      modello .example, /home/<HS_USER>, segreti dello scanner gitleaks; una riga con FAKE o EXAMPLE e' un dato di prova)
#   3. attribuzione all'AI: hs-attribution text (#474)
# Uso: scripts/appetito-check DIR [--env FILE]... [--attribution CMD]
# I valori finti del modello contano come personali: nessuno deve comparire nella copia.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd); dir=''; envs=''; attr=$repo/device/edge/debian/hs-attribution
while [ $# -gt 0 ]; do
  case $1 in
    --env) envs="$envs $2"; shift 2 ;;
    --attribution) attr=$2; shift 2 ;;
    -*) echo "opzione sconosciuta: $1" >&2; exit 2 ;;
    *) dir=$1; shift ;;
  esac
done
[ -d "$dir" ] || { echo "uso: appetito-check DIR [--env FILE]..." >&2; exit 2; }
if [ -z "$envs" ]; then
  for f in "$repo/device/edge/home-server.env" "$repo/device/edge/home-server.env.example"; do
    [ -f "$f" ] && envs="$envs $f"
  done
fi
[ -n "$envs" ] || { echo "nessun file di valori (home-server.env / .example): controllo impossibile" >&2; exit 1; }
for f in $envs; do [ -f "$f" ] || { echo "file di valori mancante: $f" >&2; exit 1; }; done
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
# Elenco dei file della copia (senza .git), senza il nome di nessuno nelle righe.
( cd "$dir" && find . -path ./.git -prune -o -type f -print | sed 's|^\./||' | sort ) > "$tmp/files"

# 1+2. Valori personali e segreti: un solo elenco, il comando hs-secrets (issue 529); dice file e riga, mai il valore.
if [ -z "${HS_SECRETS_CMD:-}" ]; then
  HS_SECRETS_CMD=$repo/device/edge/debian/hs-secrets
  [ -f "$HS_SECRETS_CMD" ] || HS_SECRETS_CMD=hs-secrets
fi
HS_SECRETS_ENV=$envs sh "$HS_SECRETS_CMD" dir "$dir" || exit 1

# 3. Attribuzione all'AI.
# I test dell'elenco stesso contengono apposta frasi di attribuzione come dati di prova: unica eccezione.
# I file che definiscono la regola (appetito/rule-files, per nome e testo fisso) non contano per le sole righe
# della regola; ogni altra loro riga e' controllata.
rules=${HS_APPETITO_RULE_FILES:-$repo/appetito/rule-files}
while IFS= read -r f; do
  case $f in device/edge/tests/attribution.sh|device/edge/tests/projects-publish.sh) continue ;; esac
  src=$dir/$f
  if [ -f "$rules" ]; then
    grep -v '^[[:space:]]*#' "$rules" | sed -n "s/^$(printf '%s' "$f" | sed 's|[][\.*^$/]|\\&|g') | //p" > "$tmp/skip"
    if [ -s "$tmp/skip" ]; then grep -vF -f "$tmp/skip" "$dir/$f" > "$tmp/filtered" || true; src=$tmp/filtered; fi
  fi
  if ! out=$(sh "$attr" text "$src" 2>&1); then
    echo "$f: $out"; exit 1
  fi
done < "$tmp/files"
echo "appetito-check: ok ($(wc -l < "$tmp/files") file)"
