[Unit]
Description=appetito tracker (issues board, proposals, approvals)
After=network-online.target

[Service]
User=tracker
Group=tracker
SupplementaryGroups=appetito-issues
EnvironmentFile=/etc/appetito/appetito.env
Environment=TRACKER_REPO=/opt/appetito/repo TRACKER_STATE=/var/lib/appetito/tracker TRACKER_PUBLIC=/opt/appetito/current/core/tracker/public
ExecStart=/usr/bin/env node /opt/appetito/current/guard/tracker/server.js
Restart=always
RestartSec=2
UMask=0002
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/appetito/repo/issues /var/lib/appetito/tracker /var/lib/appetito/requests /var/lib/appetito/settings.env /var/lib/appetito/worker-request /var/lib/appetito/issues-meta
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
