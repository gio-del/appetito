#!/usr/bin/env node
// brain-usage (root-owned, run as brain: sudo -n -H -u brain brain-usage; issue 130): what brain's
// Claude runs cost, for claude-usage (gio), which must not read them: they carry vault text. Same
// analysis as claude-usage (its analyse(), loaded from /usr/local/lib/hs/claude-usage.js or next to
// this file), but it prints only numbers: no paths (Read paths dropped), no text; the model is reduced
// to [A-Za-z0-9._-], a tool name not shaped like one counts as "altro". Jobs: brain-sort
// (~/.local/state/brain/runs, kept by hs-runlog) and brain-interattivo (~/.claude/projects/*/*.jsonl,
// headless transcripts skipped, usage deduplicated by message.id, list price). Output: one JSON array of runs.
// CLI: brain-usage [--since YYYY-MM-DD]. Env (tests): BRAIN_USAGE_RUNS, BRAIN_USAGE_SESSIONS.
'use strict';
const fs = require('fs');
const path = require('path');
const LIB = '/usr/local/lib/hs/claude-usage.js';
const cu = require(fs.existsSync(LIB) ? LIB : path.join(__dirname, 'claude-usage'));

const HOME = process.env.HOME || '/home/brain';
const RUNS = process.env.BRAIN_USAGE_RUNS || path.join(HOME, '.local/state/brain/runs');
const SESSIONS = process.env.BRAIN_USAGE_SESSIONS || path.join(HOME, '.claude/projects');
const argv = process.argv.slice(2);
let since = null;
if (argv[0] === '--since' && /^\d{4}-\d{2}-\d{2}$/.test(argv[1] || '') && argv.length === 2) since = argv[1];
else if (argv.length) { process.stderr.write('usage: brain-usage [--since YYYY-MM-DD]\n'); process.exit(2); }

const safe = s => String(s == null ? '' : s).replace(/[^A-Za-z0-9._-]/g, '').slice(0, 64);
const num = x => (typeof x === 'number' && Number.isFinite(x) ? x : 0);
// Tool names: only name-shaped keys (Read, Bash, mcp__x__y…); anything else counts as "altro".
const key = k => /^[A-Za-z][A-Za-z0-9_]{0,63}$/.test(k) ? k : 'altro';
const counts = o => { const c = {}; for (const [k, v] of Object.entries(o || {})) c[key(k)] = (c[key(k)] || 0) + num(v); return c; };
const p2 = n => String(n).padStart(2, '0');
const local = t => { const x = new Date(t); return `${x.getFullYear()}-${p2(x.getMonth() + 1)}-${p2(x.getDate())} ${p2(x.getHours())}:${p2(x.getMinutes())}`; };

// Whitelist copy of an analyse() result: numbers, counts and fixed strings only.
function clean(r, job, start, outcome) {
  const segs = {};
  for (const [w, l] of Object.entries(r.segments || {})) segs[safe(w)] = l.map(s => ({ resetsAt: num(s.resetsAt), first: num(s.first), last: num(s.last) }));
  const quota = {};
  for (const [w, q] of Object.entries(r.quota || {})) quota[safe(w)] = { delta: num(q.delta), start: q.start == null ? null : num(q.start),
    end: q.end == null ? null : num(q.end), resetsAt: q.resetsAt == null ? null : num(q.resetsAt) };
  const t = r.tokens || {};
  return { job, run: start.replace(' ', '_').replace(':', ''), start, outcome, model: safe(r.model) || null,
    cost: num(r.cost), costEstimated: job === 'brain-interattivo', turns: num(r.turns), durationMs: num(r.durationMs),
    isError: !!r.isError, limited: !!r.limited,
    tokens: { input: num(t.input), cacheWrite: num(t.cacheWrite), cacheRead: num(t.cacheRead), output: num(t.output), thinking: num(t.thinking) },
    prefixTokens: num(r.prefixTokens), prefixShare: num(r.prefixShare), tools: counts(r.tools), bash: counts(r.bash),
    toolOutputBytes: counts(r.toolOutputBytes), denied: num(r.denied), deniedTools: counts(r.deniedTools), quota, segments: segs };
}

const out = [];
let files = [];
try { files = fs.readdirSync(RUNS).filter(f => /^\d{4}-\d{2}-\d{2}_\d{4}_sort\.jsonl(\.gz)?$/.test(f)).sort(); } catch { /* no runs yet */ }
for (const f of files) {
  if (since && f.slice(0, 10) < since) continue;
  let r;
  try { r = cu.analyse(cu.readStream(path.join(RUNS, f))); } catch { continue; }
  const outcome = r.limited ? 'limite' : (r.isError || !r.subtype) ? 'errore' : 'ok';
  out.push(clean(r, 'brain-sort', `${f.slice(0, 10)} ${f.slice(11, 13)}:${f.slice(13, 15)}`, outcome));
}
let tr = [];
try {
  for (const d of fs.readdirSync(SESSIONS)) {
    try { for (const f of fs.readdirSync(path.join(SESSIONS, d))) if (f.endsWith('.jsonl')) tr.push(path.join(SESSIONS, d, f)); } catch { /* skip */ }
  }
} catch { /* no sessions */ }
for (const file of tr) {
  let ev;
  try { ev = cu.readStream(file); } catch { continue; }
  ev = ev.filter(e => (e.type === 'assistant' || e.type === 'user') && e.message && e.entrypoint !== 'sdk-cli'
    && !(since && typeof e.timestamp === 'string' && local(e.timestamp).slice(0, 10) < since));
  if (!ev.some(e => e.type === 'assistant' && e.message.usage)) continue;
  const r = cu.analyse(ev);
  const ts = ev.map(e => Date.parse(e.timestamp)).filter(Number.isFinite);
  if (!ts.length) continue;
  r.durationMs = Math.max(...ts) - Math.min(...ts);
  r.cost = r.listCost || 0;
  out.push(clean(r, 'brain-interattivo', local(Math.min(...ts)), 'sessione'));
}
process.stdout.write(JSON.stringify(out.sort((a, b) => a.start.localeCompare(b.start))) + '\n');
