#!/bin/sh
# The one secrets and personal-values scanner of this server (issue 529, epic 526). Secrets come from gitleaks
# (pinned, installed by hs-scanner-fetch, no network when it runs); personal values (every value of
# home-server.env and of its .example model, and /home/<HS_USER>) from the same rules appetito-check used to
# carry. Exit 1 at the first problem with file, commit and line, NEVER the secret value (gitleaks --redact,
# values are not printed, only where they sit). A line with FAKE or EXAMPLE is test data and passes.
# Usage:
#   hs-secrets text [FILE]           the text (stdin without FILE)
#   hs-secrets dir DIR               every file of a folder (not .git)
#   hs-secrets history REPO [REV...] every commit of every branch (or the given git log revisions, e.g.
#                                    "A..B" for the commits about to be pushed); commit author mail addresses
#                                    are listed apart as information (INFO), they never block
#   hs-secrets verdict REPO          before making a repo public: history + current tree, readable verdict
# Environment: HS_GITLEAKS (binary), HS_SECRETS_ENV (space separated env files; default /etc/home-server.env
# and the .example model next to the repo copy or in /usr/local/share/hs).
set -u
# The one exception (issue 588): the old public history of Appetito (commits up to this one, October 2026) holds
# the repo address and the owner's GitHub login on purpose (README clone line, launch post). In `history` only,
# for the repo that has this commit, those two values (by variable name, never the value) are accepted in the
# commits that are ancestors of it; a later commit, the current files and any other repo stay blocked. The
# verdict prints an INFO line saying so. Overridable only for the test.
ACCEPT_REV=${HS_SECRETS_ACCEPT_REV:-db165a945c011f0e844a135281a504e0b0d1cf0d}
ACCEPT_KEYS=${HS_SECRETS_ACCEPT_KEYS:-HS_LEETCODE_USER HS_APPETITO_REPO}
GL=${HS_GITLEAKS:-/usr/local/lib/hs/gitleaks}
here=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
die() { echo "hs-secrets: $*" >&2; exit 2; }
[ -x "$GL" ] || die "scanner non installato ($GL): deploy esegue hs-scanner-fetch"

envs=${HS_SECRETS_ENV:-}
if [ -z "$envs" ]; then
	for f in /etc/home-server.env "$here/../home-server.env.example" "$here/../device/edge/home-server.env.example" /usr/local/share/hs/home-server.env.example; do
		[ -f "$f" ] && envs="$envs $f"
	done
fi
[ -n "$envs" ] || die "nessun file di valori (home-server.env / .example): controllo impossibile"
for f in $envs; do [ -f "$f" ] || die "file di valori mancante: $f"; done

# gitleaks config: its default rules, FAKE/EXAMPLE lines allowed.
cat > "$tmp/gl.toml" <<'EOF'
[extend]
useDefault = true

[[allowlists]]
description = "test data"
regexTarget = "line"
regexes = ['''FAKE|EXAMPLE''']
EOF

# Personal-value expressions (one per line: KEY<TAB>SRC<TAB>grep -E regex, case-insensitive).
: > "$tmp/vals"; : > "$tmp/re"
for f in $envs; do
	grep -E '^[A-Z_]+=' "$f" | while IFS= read -r l; do
		k=${l%%=*}; v=${l#*=}; v=${v%\"}; v=${v#\"}
		[ -n "$v" ] || continue
		# HS_TS_NAME is a common word (and part of HS_TS_HOST, searched whole); the others are settings (true/false, a date) not personal (the owner's GitHub login, HS_LEETCODE_USER, is, issue 568)
		case $k in HS_AUTO_MODEL|HS_SUGGEST_MODEL|HS_BRAIN_MODEL|HS_REPO|HS_TS_NAME|HS_SECURITY_ENABLED|HS_LEETCODE_SINCE) continue ;; esac
		printf '%s\t%s\t%s\n' "$k" "$v" "${f##*/}"
	done >> "$tmp/vals"
done
add() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$tmp/re"; }
while IFS="$(printf '\t')" read -r k v src; do
	q=$(printf '%s' "$v" | sed 's/[][\.*^$(){}?+|/]/\\&/g')
	add "$k" "$src" "/home/$q([^A-Za-z0-9_.-]|\$)"
	# the model's generic words (me, server) count only when they hold a dot or digit; values under 4 characters
	# count only as /home/<value>
	generic=0; case $src in *.example) case $v in *[.0-9]*) ;; *) generic=1 ;; esac ;; esac
	if [ "$k" != HS_USER ] && [ $generic = 0 ] && [ "${#v}" -ge 4 ]; then
		add "$k" "$src" "(^|[^A-Za-z0-9_.-])$q([^A-Za-z0-9_-]|\$)"
	fi
done < "$tmp/vals"

rc=0
# pv FILE LABEL [lines]: personal values in FILE (lines: FILE is "COMMIT<TAB>PATH<TAB>LINENO<TAB>TEXT" rows,
# from history). Prints where, not what; first problem only per value.
pv() {
	while IFS="$(printf '\t')" read -r k src re; do
		if [ "${3:-}" = rows ]; then
			f=$1
			# the model holds its own fake values on purpose (as in the file modes)
			[ "$src" = home-server.env.example ] && f=$tmp/rows.nm
			acc=0
			case " $ACCEPT_KEYS " in *" $k "*) [ -s "$tmp/anc" ] && { f=$tmp/rows.new; acc=1; } ;; esac
			l=$(cut -f4- "$f" | grep -Ein -m1 -e "$re") || {
				if [ $acc = 1 ] && cut -f4- "$1" | grep -Eiq -e "$re"; then
					echo "INFO storia vecchia accettata ($k): presente solo nei commit fino a ${ACCEPT_REV%"${ACCEPT_REV#???????}"}, scelta dell'owner (issue 588)" >> "$tmp/accepted"
				fi
				continue
			}
			n=${l%%:*}; row=$(sed -n "${n}p" "$f")
			echo "valore personale ($k): commit $(printf '%s' "$row" | cut -f1), $(printf '%s' "$row" | cut -f2):$(printf '%s' "$row" | cut -f3)"
		else
			# the model holds its own fake values on purpose
			case $src:$2 in home-server.env.example:*home-server.env.example) continue ;; esac
			l=$(grep -Eni -m1 -e "$re" "$1" 2> /dev/null) || continue
			echo "valore personale ($k): $2:${l%%:*}"
		fi
		rc=1
	done < "$tmp/re"
}
# Our own patterns, second pass: gitleaks drops obvious placeholder runs (abcdef...), these do not.
SECRET_RE='-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|gh[ousr]_[A-Za-z0-9]{30,}|sk-ant-[A-Za-z0-9_-]{20,}|tskey-[A-Za-z0-9-]{16,}|AGE-SECRET-KEY-[A-Z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|(password|passwd|secret|token|api[_-]?key)[A-Za-z_]*[ \t]*[:=][ \t]*["'"'"'][A-Za-z0-9+/_-]{16,}["'"'"']'
# own FILE LABEL [rows]: where a pattern matches (never the text); rows = history rows, see pv.
own() {
	if [ "${3:-}" = rows ]; then
		l=$(cut -f4- "$1" | grep -EIn -e "$SECRET_RE" | grep -v -e FAKE -e EXAMPLE | head -n 1)
		[ -n "$l" ] || return 0
		row=$(sed -n "${l%%:*}p" "$1")
		echo "segreto (modello): commit $(printf '%s' "$row" | cut -f1), $(printf '%s' "$row" | cut -f2):$(printf '%s' "$row" | cut -f3)"
	else
		l=$(grep -EIn -e "$SECRET_RE" "$1" 2> /dev/null | grep -v -e FAKE -e EXAMPLE | head -n 1)
		[ -n "$l" ] || return 0
		echo "segreto (modello): $2:${l%%:*}"
	fi
	rc=1
}
# gl_report FILE: gitleaks JSON report -> one line per finding (rule, file, commit, line), never the secret.
gl_report() {
	[ -s "$1" ] || return 0
	n=$(jq 'length' "$1" 2> /dev/null || echo 0); [ "$n" -gt 0 ] || return 0
	jq -r --arg p "${strip:-}" '.[] | "segreto (\(.RuleID)): \(.File | ltrimstr($p)):\(.StartLine)" + (if (.Commit // "") != "" then ", commit \(.Commit[0:7])" else "" end)' "$1"
	rc=1
}
gl() { # gl KIND TARGET [extra args]: run gitleaks, redacted, quiet, report in $tmp/rep.json
	kind=$1; target=$2; shift 2
	"$GL" "$kind" "$target" --config "$tmp/gl.toml" --redact --no-banner --no-color --log-level error \
		--report-format json --report-path "$tmp/rep.json" --exit-code 0 "$@" > /dev/null 2>&1 || die "gitleaks non è riuscito a leggere $target"
	gl_report "$tmp/rep.json"
}

mode=${1:-}
case $mode in
text)
	mkdir "$tmp/t"
	if [ -n "${2:-}" ]; then cat -- "$2" > "$tmp/t/testo"; else cat > "$tmp/t/testo"; fi
	strip=$tmp/t/; gl dir "$tmp/t"
	own "$tmp/t/testo" testo; pv "$tmp/t/testo" testo ;;
dir)
	[ -d "${2:-}" ] || die "uso: hs-secrets dir DIR"
	d=$2
	# the folder itself, no copy (a Project folder can hold hundreds of MB); .git is never read as files
	c=${d%/}; strip=$c/
	gl dir "$c" --max-archive-depth 0
	# one grep over the whole folder for each list (forks are slow on a phone), then the per-value detail only on the files that hit
	cut -f3 "$tmp/re" > "$tmp/re.only"
	grep -rEIn -e "$SECRET_RE" "$c" --exclude-dir=.git 2> /dev/null | grep -v -e FAKE -e EXAMPLE | head -n 50 |
		while IFS=: read -r p n _; do echo "segreto (modello): ${p#"$c"/}:$n"; done > "$tmp/own.out"
	if [ -s "$tmp/own.out" ]; then cat "$tmp/own.out"; rc=1; fi
	grep -rEIil -f "$tmp/re.only" "$c" --exclude-dir=.git 2> /dev/null | head -n 200 > "$tmp/hits" || true
	while IFS= read -r p; do pv "$p" "${p#"$c"/}"; done < "$tmp/hits" ;;
history)
	r=${2:-}; git -C "$r" rev-parse --git-dir > /dev/null 2>&1 || die "uso: hs-secrets history REPO [REV...]"
	shift 2
	if [ $# -gt 0 ]; then gl git "$r" --log-opts "$*"; else gl git "$r" --log-opts "--all"; fi
	# personal values in what the commits added
	git -C "$r" log ${*:---all} -p -U0 --no-color --format='@@@ %h' 2> /dev/null | awk -F'\t' '
		/^@@@ / { c = $0; sub(/^@@@ /, "", c); next }
		/^\+\+\+ / { f = $0; sub(/^\+\+\+ (b\/)?/, "", f); next }
		/^@@ / { s = $0; sub(/^@@ -[0-9,]+ \+/, "", s); sub(/[ ,].*/, "", s); n = s + 0; next }
		/^\+/ { printf "%s\t%s\t%d\t%s\n", c, f, n, substr($0, 2); n++ }' > "$tmp/rows"
	# the accepted old history: short hashes of the ancestors of the pinned commit, if this repo has it
	awk -F'\t' '$2 !~ /(^|\/)home-server\.env\.example$/' "$tmp/rows" > "$tmp/rows.nm"
	: > "$tmp/anc"; : > "$tmp/accepted"
	if git -C "$r" cat-file -e "$ACCEPT_REV^{commit}" 2> /dev/null; then
		git -C "$r" log "$ACCEPT_REV" --format=%h 2> /dev/null > "$tmp/anc"
		awk -F'\t' 'NR == FNR { a[$1]; next } !($1 in a)' "$tmp/anc" "$tmp/rows" > "$tmp/rows.new"
	fi
	own "$tmp/rows" history rows; pv "$tmp/rows" history rows
	sort -u "$tmp/accepted"
	# author addresses: information, not a block
	git -C "$r" log ${*:---all} --format='%ae%n%ce' 2> /dev/null | sort -u | sed '/^$/d' > "$tmp/mails"
	[ -s "$tmp/mails" ] && echo "INFO indirizzi mail negli autori dei commit: $(wc -l < "$tmp/mails")" &&
		sed 's/^/INFO   /' "$tmp/mails" ;;
verdict)
	r=${2:-}; git -C "$r" rev-parse --git-dir > /dev/null 2>&1 || die "uso: hs-secrets verdict REPO"
	h=$(sh "$0" history "$r"); hrc=$?
	# the files the repo tracks (HEAD), not a working tree with node_modules
	mkdir "$tmp/v"; git -C "$r" archive HEAD | tar -x -C "$tmp/v" || die "git archive fallito"
	d=$(sh "$0" dir "$tmp/v"); drc=$?
	printf '%s\n' "$h" | grep -v '^INFO' ; printf '%s\n' "$d"
	printf '%s\n' "$h" | grep '^INFO'
	if [ $hrc = 0 ] && [ $drc = 0 ]; then echo "VERDETTO: pubblicabile (storia e file attuali puliti)"; exit 0; fi
	echo "VERDETTO: NON pubblicare (storia: $([ $hrc = 0 ] && echo pulita || echo problemi), file attuali: $([ $drc = 0 ] && echo puliti || echo problemi))"; exit 1 ;;
*) echo "uso: hs-secrets text [FILE] | dir DIR | history REPO [REV...] | verdict REPO" >&2; exit 64 ;;
esac
exit $rc
