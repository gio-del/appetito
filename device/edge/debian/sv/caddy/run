#!/bin/sh
exec 2>&1
# Unprivileged: user caddy with only CAP_NET_BIND_SERVICE (for :80/:8443), no new privileges.
# Admin API socket lives in /run/caddy (tmpfs, recreated here; only root and caddy can enter).
install -d -m 750 -o caddy -g caddy /run/caddy
install -d -m 750 -o caddy -g caddy /var/log/caddy  # access logs of the Projects' apps (issue 477)
chown caddy:caddy /var/log/caddy/*.log 2>/dev/null || true  # `caddy validate` in the deploy runs as root and may create them
rm -f /run/caddy/admin.sock
export HOME=/var/lib/caddy XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
exec setpriv --reuid=caddy --regid=caddy --init-groups --no-new-privs \
	--inh-caps=-all,+net_bind_service --ambient-caps=-all,+net_bind_service --bounding-set=-all,+net_bind_service \
	/usr/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile --envfile /etc/home-server.env
