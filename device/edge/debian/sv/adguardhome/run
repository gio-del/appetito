#!/bin/sh
exec 2>&1
# Unprivileged: user adguard with only CAP_NET_BIND_SERVICE (for :53), no new privileges.
export HOME=/var/lib/adguardhome
exec setpriv --reuid=adguard --regid=adguard --init-groups --no-new-privs \
	--inh-caps=-all,+net_bind_service --ambient-caps=-all,+net_bind_service --bounding-set=-all,+net_bind_service \
	/opt/AdGuardHome/AdGuardHome --no-check-update -c /var/lib/adguardhome/AdGuardHome.yaml -w /var/lib/adguardhome --web-addr 127.0.0.1:3000
