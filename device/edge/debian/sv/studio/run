#!/bin/sh
# studio (issue 448, optional: enabled by `studio-setup --enable`): the study session, user studio (no sudo, no
# secrets of the server), cwd ~studio/studio, kept alive in tmux session "studio" for Remote Control from the phone
# (session "studio"). --restricted: no shell or code-running tools, file tools confined to the folder, writes to
# settings/git/tool-config files only with a person's approval, no bypass; --tools adds web search and fetch (the only
# Claude with web on this server; studio-fw.sh keeps it off local services and private networks);
# --strict-mcp-config: no MCP servers, not even the account's claude.ai connectors.
# Idles until the owner has done /login as studio once.
exec 2>&1
H=$(getent passwd studio | cut -d: -f6)
# Waiting is a loop inside this process, not an exit: runit would restart it every 5 min and hs-monitor reads that as a restart loop (issue 453).
[ -n "$H" ] || { echo "studio: no user studio"; sleep 300; exit 1; }
n=0
while [ ! -s "$H/.claude/.credentials.json" ]; do
  [ $n -eq 0 ] && echo "studio: waiting for /login"; n=1; sleep 30
done
export HOME=$H USER=studio LOGNAME=studio SHELL=/bin/bash TERM=xterm-256color LANG=C.UTF-8 \
  PATH=$H/.local/bin:/usr/local/bin:/usr/bin:/bin CLAUDE_CODE_TMPDIR=$H/.cache/claude-tmp
exec setpriv --reuid=studio --regid=studio --init-groups --no-new-privs sh -c '
  # 027: the files of the programme are readable by the group studioapp (the app, issue 461), not by others.
  umask 027
  # brain-refresh studio (issue 448) leaves the id of the conversation it closed: resume it once.
  R=$HOME/.local/state/studio-resume-id; a=""
  if [ -s "$R" ]; then a="--resume $(tr -dc 0-9a-f- < "$R") "; fi; rm -f "$R"
  tmux has-session -t studio 2>/dev/null ||
    tmux new-session -d -s studio -c "$HOME/studio" \
      "claude ${a}--restricted --tools Read,Edit,Write,Glob,Grep,WebFetch,WebSearch --strict-mcp-config --remote-control studio" || exit 1
  while tmux has-session -t studio 2>/dev/null; do sleep 20; done'
