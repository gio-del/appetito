#!/bin/sh
exec 2>&1
set -a; . /etc/home-server.env; set +a
# Signups are opened once for the owner's account, then closed: see /var/lib/vaultwarden/signups
SIGNUPS=false
[ -f /var/lib/vaultwarden/signups ] && SIGNUPS=$(cat /var/lib/vaultwarden/signups)
export DATA_FOLDER=/var/lib/vaultwarden WEB_VAULT_FOLDER=/opt/vaultwarden/web-vault \
	ROCKET_ADDRESS=127.0.0.1 ROCKET_PORT=8222 \
	DOMAIN=https://$HS_TS_HOST:8443 \
	SIGNUPS_ALLOWED=$SIGNUPS INVITATIONS_ALLOWED=false SHOW_PASSWORD_HINT=false \
	PASSWORD_HINTS_ALLOWED=false IP_HEADER=X-Forwarded-For LOG_LEVEL=warn
exec chpst -u vaultwarden:vaultwarden /opt/vaultwarden/vaultwarden
