#!/bin/sh
# ops-auto-request ($HS_USER's cron, every minute; issue 067): starts ops-auto when the owner
# pressed "Avvia ora" / "Lavora su questa issue" in the tracker. The tracker (user tracker) can't
# run anything as $HS_USER: it writes /var/lib/ops-auto-req/request.json ({id, at, issue|null})
# and this job, seeing an id it hasn't handled yet, starts `ops-auto --manual [--issue NNN]`
# detached. The answer goes to ~/.local/state/ops-auto/request.json ({id, handled, result,
# reason}), which ops-auto-card copies into the tracker's status file; the request file is never
# deleted (it belongs to the tracker), a handled id is just ignored.
# Refused: a request older than 10 minutes (the Edge was off), ops-auto already running,
# ops-auto itself still checks the quota and the issue (uncommitted files never block: issue 637).
# Race (issue 347): if a scheduled round takes the lock between this check and the start, the manual
# ops-auto waits up to 2 minutes for it; if it can't run it rewrites this answer as `busy` with the reason.
# Fresh queue (issue 099): when an issue file or the open/done dirs changed since ops-auto-card last
# wrote its status (a new To do issue, a closure), the card is rewritten now instead of at the next
# hs-monitor run; the settings file counts too (issue 176: a quota change shows at once); with no
# change nothing runs.
set -eu
export PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8
REQ=${HS_AUTO_REQUEST:-/var/lib/ops-auto-req/request.json}
ST=$HOME/.local/state/ops-auto
DETAIL=${HS_AUTO_DETAIL:-/var/lib/edge-status/ops-auto.json}
I=$HOME/home-server/issues
SETF=${HS_SETTINGS_FILE:-/var/lib/hs-settings/settings.env}
if [ ! -e "$DETAIL" ] || [ -n "$(find "$I/open" "$I/done" "$SETF" -newer "$DETAIL" -print -quit 2>/dev/null)" ]; then
	"$HOME/bin/ops-auto-card" 2>/dev/null || true
fi
[ -s "$REQ" ] || exit 0
id=$(jq -r '.id // empty | select(test("^[a-f0-9]{16}$"))' "$REQ" 2>/dev/null) || exit 0
[ -n "$id" ] || exit 0
[ "$(jq -r '.id // empty' "$ST/request.json" 2>/dev/null)" = "$id" ] && exit 0
at=$(jq -r '.at // 0 | floor' "$REQ")
issue=$(jq -r '.issue // empty | select(test("^([0-9]{3,4}|[a-z0-9][a-z0-9-]{0,40}#[0-9]{1,6})$"))' "$REQ")
mkdir -p "$ST"
answer() {
	jq -n --arg id "$id" --arg r "$1" --arg why "${2:-}" --arg issue "$issue" \
		'{id:$id, handled:(now|floor), result:$r, reason:$why, issue:(if $issue=="" then null else $issue end)}' > "$ST/request.json.tmp"
	mv "$ST/request.json.tmp" "$ST/request.json"
	echo "$(date '+%F %T') request $id${issue:+ $([ "${issue#*#}" = "$issue" ] && echo "#$issue" || echo "$issue")}: $1${2:+ ($2)}" >> "$ST/ops-auto.log"
	"$HOME/bin/ops-auto-card" 2>/dev/null || true
}
if [ $(($(date +%s) - at)) -gt 600 ]; then answer refused "richiesta scaduta"; exit 0; fi
if [ -e "$ST/lock" ] && ! flock -n "$ST/lock" true; then answer refused "già al lavoro"; exit 0; fi
answer started
# Detached from this job: a run can take up to an hour.
setsid hs-run ops-auto "$HOME/bin/ops-auto" --manual ${issue:+--issue "$issue"} >> "$HOME/.local/state/ops-auto.log" 2>&1 < /dev/null &
