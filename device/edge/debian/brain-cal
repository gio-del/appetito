#!/bin/sh
# CalDAV helper for the second brain (user brain): the only way the sorting job touches the
# owner's calendars, so it never needs curl or the network. Talks to Radicale on 127.0.0.1 with
# brain's account (~/.secrets/radicale); Radicale rights limit it to items in the two calendars.
#   brain-cal add  calendario|attivita FILE.ics   new item (refused if its UID exists)
#   brain-cal edit calendario|attivita FILE.ics   replace an existing item (same UID)
#   brain-cal list calendario|attivita            print the whole calendar (iCalendar)
set -eu
. /etc/home-server.env
B=http://127.0.0.1:5232/$HS_USER
P=$HOME/.secrets/radicale
die() { echo "brain-cal: $*" >&2; exit 1; }
usage() { sed -n '5,7s/^# //p' "$0" >&2; exit 2; }
[ $# -ge 2 ] || usage
case $2 in calendario|attivita) ;; *) usage ;; esac
cfg() { printf 'user = "brain:%s"\n' "$(cat "$P")"; }
case $1 in
list)
	cfg | curl -fsS -K - "$B/$2/" ;;
add|edit)
	[ $# -eq 3 ] && [ -f "$3" ] || usage
	head -1 "$3" | grep -q '^BEGIN:VCALENDAR' || die "$3 is not an iCalendar file"
	uid=$(sed -n 's/^UID:\(.*\)$/\1/p' "$3" | tr -d '\r' | sort -u)
	[ "$(printf '%s\n' "$uid" | grep -c .)" -eq 1 ] || die "$3 needs exactly one UID"
	printf '%s' "$uid" | grep -Eq '^[A-Za-z0-9@._-]{1,200}$' || die "UID must match [A-Za-z0-9@._-]"
	case $2 in calendario) want=VEVENT ;; *) want=VTODO ;; esac
	grep -q "^BEGIN:$want" "$3" || die "$2 takes $want items"
	# add: If-None-Match makes Radicale refuse an existing UID. edit: Radicale ignores If-Match: *,
	# so check that the item exists first.
	cond="If-None-Match: *"
	if [ "$1" = edit ]; then
		[ "$(cfg | curl -sS -K - -o /dev/null -w '%{http_code}' "$B/$2/$uid.ics")" = 200 ] || die "no item $uid in $2"
		cond="X-HS: edit"
	fi
	code=$(cfg | curl -sS -K - -o /dev/null -w '%{http_code}' -X PUT -H "$cond" \
		-H 'Content-Type: text/calendar; charset=utf-8' --data-binary "@$3" "$B/$2/$uid.ics")
	case $code in
	201|204) echo "ok: $2/$uid" ;;
	412) die "UID $uid already exists in $2 (use edit)" ;;
	*) die "PUT $2/$uid failed: HTTP $code" ;;
	esac ;;
*) usage ;;
esac
