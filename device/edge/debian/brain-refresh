#!/bin/sh
# brain-refresh (issue 445): like ops-refresh (421/441) for the interactive `brain` session (user brain, tmux "brain").
# claude-update-all (442) moves ~brain/.local/bin/claude to the new version, the running process keeps the old one.
# Root cron: if the running binary differs from the installed one AND the session was idle HS_OPS_REFRESH_IDLE_MIN
# minutes (tmux window activity and newest transcript), save the id of the newest transcript (FILE NAME only, never its
# content; headless jobs use --no-session-persistence) to BRAIN_REFRESH_RESUME_FILE and kill the tmux session: the runit
# service `brain` reopens it with `--resume <id> --remote-control brain`. hs-notify tells the owner (once when deferred, at restart).
# Usage: brain-refresh [USER WORKDIR]: the same for another session kept like brain's, whose tmux session is named like
# its user and runs in WORKDIR (issue 448: `brain-refresh studio /home/studio/studio`). Default: brain in /srv/vault.
# A user that does not exist (optional session off) is a no-op.
# Env overrides (tests): BRAIN_REFRESH_RESUME_FILE, _NOTIFY, _DEFER_FILE, _SESSION, _HOME, _LINK, _IDLE_MIN, _TRANSCRIPTS, _NOW, _TMUX (command prefix).
set -eu
U=${1:-brain}
WD=${2:-/srv/vault}
SESSION=${BRAIN_REFRESH_SESSION:-$U}
BH=${BRAIN_REFRESH_HOME:-$(getent passwd "$U" | cut -d: -f6)}
[ -n "$BH" ] || exit 0
LINK=${BRAIN_REFRESH_LINK:-$BH/.local/bin/claude}
TRANS=${BRAIN_REFRESH_TRANSCRIPTS:-$BH/.claude/projects/$(echo "$WD" | tr / -)}
IDLE=${BRAIN_REFRESH_IDLE_MIN:-$(hs-setting HS_OPS_REFRESH_IDLE_MIN 2>/dev/null || echo 15)}
NOW=${BRAIN_REFRESH_NOW:-$(date +%s)}
RESUME=${BRAIN_REFRESH_RESUME_FILE:-$BH/.local/state/$U-resume-id}
DEFER=${BRAIN_REFRESH_DEFER_FILE:-/var/lib/$U-refresh-notified}
NOTIFY=${BRAIN_REFRESH_NOTIFY:-hs-notify}
TMUX=${BRAIN_REFRESH_TMUX:-runuser -u $U -- tmux}
log() { echo "$(date '+%F %T') brain-refresh: $*"; }
ver() { b=$(basename "$1"); [ "$b" != claude ] || b=$(basename "$(dirname "$1")"); echo "$b"; }

$TMUX has-session -t "$SESSION" 2>/dev/null || exit 0
installed=$(readlink -f "$LINK" 2>/dev/null) || exit 0
[ -n "$installed" ] && [ -x "$installed" ] || exit 0

running=""
pids=$($TMUX list-panes -t "$SESSION" -F '#{pane_pid}')
while [ -n "$pids" ] && [ -z "$running" ]; do
	next=""
	for p in $pids; do
		exe=$(readlink "/proc/$p/exe" 2>/dev/null | sed 's/ (deleted)$//') || exe=""
		case $(basename "${exe:-x}") in
		sh|bash|dash|"") ;;
		*) running=$exe; break ;;
		esac
		next="$next $(pgrep -P "$p" 2>/dev/null || true)"
	done
	pids=$next
done
[ -n "$running" ] || exit 0
[ "$running" = "$installed" ] && exit 0

last=$($TMUX display-message -p -t "$SESSION" '#{window_activity}' 2>/dev/null || echo 0)
t=$(find "$TRANS" -maxdepth 1 -name '*.jsonl' -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)
[ -n "$t" ] && [ "$t" -gt "$last" ] && last=$t
age=$((NOW - last))
if [ "$age" -lt $((IDLE * 60)) ]; then
	log "new version installed ($running -> $installed) but session active ${age}s ago, retry next round"
	if [ "$(cat "$DEFER" 2>/dev/null)" != "$installed" ]; then
		echo "$installed" > "$DEFER"
		"$NOTIFY" "Sessione $SESSION: versione nuova in attesa" "Claude Code $(ver "$running") -> $(ver "$installed"): la sessione è in uso, la riapro (stessa chat) appena resta ferma $IDLE minuti." || true
	fi
	exit 0
fi
log "restarting session $SESSION: $running -> $installed (idle ${age}s)"
id=$(find "$TRANS" -maxdepth 1 -name "*.jsonl" -size +0 -printf "%T@ %f\n" 2>/dev/null | sort -n | tail -1 | cut -d" " -f2)
id=${id%.jsonl}
if [ -n "$id" ]; then
	echo "$id" > "$RESUME"; chown "$U" "$RESUME" 2>/dev/null || true; out="stessa chat ripresa"
else rm -f "$RESUME"; out="nessuna chat in corso, sessione nuova"; fi
$TMUX kill-session -t "$SESSION"
"$NOTIFY" "Sessione $SESSION riavviata" "Claude Code $(ver "$running") -> $(ver "$installed"): $out." || true
