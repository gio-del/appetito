# home-server personal values. Copy to device/edge/home-server.env (gitignored),
# fill in, and deploy with device/edge/deploy (installs it as /etc/home-server.env).
# Values only, never secrets: secrets stay in ~/.secrets on the device.

# Linux user that owns the vault, runs Syncthing and is the login of the web UIs
HS_USER=me
# Tailscale MagicDNS short name and full name of the server
HS_TS_NAME=server
HS_TS_HOST=server.tailXXXXXX.ts.net
# Tailscale IP of the server and of the admin PC (the only device allowed SSH/admin UIs)
HS_TS_IP=100.64.0.1
HS_PC_TS_IP=100.64.0.2
# Server's address on the home LAN (reserve it in the router's DHCP)
HS_LAN_IP=192.168.1.2
# Tailscale IP of a phone/other member device, used only by the ACL tests (optional)
HS_PHONE_TS_IP=100.64.0.3
# Optional (issue 015): other addresses of yours whose mail to +edge goes into the Inbox (the Google account itself always does), space-separated.
#HS_MAIL_ALLOW="me@work.example"
# Path of this repo on the server, backed up nightly by repo-backup (optional, default below)
#HS_REPO=/home/me/home-server

# Optional fallbacks for settings normally chosen on the tracker's settings page (hs-setting reads
# the page's value first). Claude model of the headless jobs: default (no --model, the account
# decides), opus, sonnet or haiku.
#HS_AUTO_MODEL=default
#HS_SUGGEST_MODEL=default
#HS_BRAIN_MODEL=sonnet

# Email of the Library guest (device shared from the admin console); empty = no guest rule
HS_LIBRARY_GUEST=
# Tailnet IP the Edge sees for that guest (shared node: `tailscale debug netmap`, the source of the 8447 rule); used by scripts/security-audit
HS_LIBRARY_GUEST_IP=

# "Security enabled" (issue 488): true (default when missing) = agent without sudo, separate deploy with
# automatic rollback, protected files, OK for everything that runs as root. false = as the owner's server.
HS_SECURITY_ENABLED=true

# LeetCode (issue 492): public profile user name; empty = no LeetCode job. Only submissions from the SINCE date count.
HS_LEETCODE_USER=
HS_LEETCODE_SINCE=2026-11-09
