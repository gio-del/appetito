#!/bin/sh
# The canonical repo on the Edge refuses a push (from the PC or anywhere) carrying Claude/AI attribution
# (issues 202, 474): only the commits it doesn't have yet are checked, plus the branch names.
. "$(dirname "$0")/attribution-common.sh"
z=0000000000000000000000000000000000000000
input=$(cat)
rc=0
while read -r old new ref; do
	[ -n "$new" ] && [ "$new" != "$z" ] || continue
	if ! out=$(printf '%s\n' "${ref#refs/heads/}" | "$A" ident); then echo "push rifiutato (issue 474), ramo $ref: $out" >&2; rc=1; fi
	if ! out=$("$A" commits "$new" --not --all); then echo "push rifiutato (issue 474): $out" >&2; rc=1; fi
done <<IN
$input
IN
[ $rc = 0 ] || exit 1
printf '%s\n' "$input" | chain pre-receive "$@"
