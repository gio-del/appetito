{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/device/edge/debian/ops-auto-guard\""
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/device/edge/debian/hs-protect-guard\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/device/edge/debian/hs-attribution\" claude-hook"
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/device/edge/debian/hs-protect-guard\""
          }
        ]
      }
    ]
  }
}
